# Шаблон окружения. Скопируйте: cp .env.example .env
# Реальный .env в архив не входит — в нём секрет.

# Секрет для подписи JWT (HS256). ОБЯЗАТЕЛЕН.
# Сгенерируйте свой: openssl rand -hex 32
JWT_SECRET=

# Имя LLM: served-model-name в vLLM и значение models.llm в /info.
LLM_MODEL=Qwen2.5-1.5B-Instruct

# HuggingFace-токен — нужен только если модель приватная или для лимитов скачивания.
HF_TOKEN=

# Данные студента для /info. Email определяет вариант CV-модели.
STUDENT_NAME=Фамилия Имя Отчество
STUDENT_EMAIL=iidemchenko@edu.hse.ru

# CV-модель варианта. Узнать: make variant
CV_MODEL=convnext_tiny

# Хост-порт gateway (base_url = http://HOST:GATEWAY_PORT).
# 8090 выбран потому, что 8080 занят другим сервисом на этом сервере.
GATEWAY_PORT=8090

# Хост-порты остальных сервисов — сдвинуты от стандартных (8090/9090/9100 заняты).
TRITON_HOST_PORT=18002
VLLM_HOST_PORT=18000
PROMETHEUS_HOST_PORT=19090
NODE_EXPORTER_HOST_PORT=19100

# Марка GPU для обязательного поля gpu в /info.
GPU_NAME=NVIDIA RTX PRO 4500 Blackwell
GATEWAY_VERSION=1.0

# Бюджет GPU для vLLM. На карте живёт прод-сервис, поэтому доля низкая.
VLLM_GPU_MEMORY_UTILIZATION=0.20
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=24

# Пороги SLO (ориентир; грейдер проверяет своими значениями).
VISION_TOP5_THRESHOLD=0.8
VISION_P95_MS=400
CHAT_TTFT_MS=2000
